{
  "name": "atlas-of-the-cosmos",
  "version": "0.1.0",
  "description": "Atlas of the Cosmos — an Annas M. Ishtiaq project.",
  "author": "Annas M. Ishtiaq",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "env:check": "node scripts/validate-environment.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "tsc -p packages/tsconfig.json --pretty false",
    "data:sample": "node --experimental-strip-types pipelines/run.mjs",
    "assets:sanitize": "node scripts/sanitize-social-image.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:a11y && npm run test:performance",
    "test:unit": "node --experimental-strip-types --test tests/run-unit.mjs",
    "test:integration": "node --experimental-strip-types --test tests/run-integration.mjs",
    "test:security": "node --experimental-strip-types --test tests/run-security.mjs",
    "test:a11y": "node --test tests/accessibility/static-a11y.test.mjs",
    "test:performance": "node --test tests/performance/performance-guards.test.mjs",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test tests/run-unit.mjs tests/run-integration.mjs tests/run-security.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "security:scan": "node scripts/security-scan.mjs",
    "security:history": "node scripts/history-secret-scan.mjs",
    "security:licenses": "node scripts/license-scan.mjs",
    "security:audit": "npm audit --audit-level=high",
    "sbom": "node scripts/generate-sbom.mjs",
    "validate": "npm run env:check && npm run format:check && npm run lint && npm run typecheck && npm run typecheck:packages && npm run data:sample && npm test && npm run test:coverage && npm run security:scan && npm run security:history && npm run security:licenses && npm run security:audit && npm run build && npm run test:rendered && npm run test:e2e && npm run sbom",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.48.0",
    "@cloudflare/workers-types": "5.20260729.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.32",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vinext": "0.2.1",
    "vite": "8.1.5",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
